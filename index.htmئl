function setZoom(v, save = true){
  v = Math.min(130, Math.max(55, Number(v) || 100));
  document.documentElement.style.setProperty('--z', v / 100);
  $('#zoom').value = v; $('#zoomVal').textContent = v + '%';
  if(save && user) writeJSON(K_ZOOM(user.username), v);
}
