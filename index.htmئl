function newId(){ return (crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(36).slice(2)); }

async function hashPass(pass, salt){
  const data = new TextEncoder().encode(salt + ':' + pass);
  if(!(crypto && crypto.subtle)) return btoa(unescape(encodeURIComponent(salt + pass)));
  const buf = await crypto.subtle.digest('SHA-256', data);
  return [...new Uint8Array(buf)].map(b => b.toString(16).padStart(2,'0')).join('');
}

/* ---------- תאריכים: הקלדה או לוח שנה ---------- */
function parseDate(str){
  str = String(str || '').trim(); if(!str) return '';
  let y, m, d, x;
  if((x = str.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/))) [, y, m, d] = x;
  else if((x = str.match(/^(\d{1,2})[\/.\-\s](\d{1,2})[\/.\-\s](\d{2}|\d{4})$/))) [, d, m, y] = x;
  else if((x = str.match(/^(\d{2})(\d{2})(\d{4})$/))) [, d, m, y] = x;
  else if((x = str.match(/^(\d{2})(\d{2})(\d{2})$/))) [, d, m, y] = x;
  else return null;
  y = +y; m = +m; d = +d; if(y < 100) y += 2000;
  const dt = new Date(y, m - 1, d);
  if(dt.getFullYear() !== y || dt.getMonth() !== m - 1 || dt.getDate() !== d) return null;
  return y + '-' + String(m).padStart(2,'0') + '-' + String(d).padStart(2,'0');
}
const fmtDate = ymd => ymd ? ymd.slice(8,10) + '/' + ymd.slice(5,7) + '/' + ymd.slice(0,4) : '';
function addMonth(ymd, day){ const [y,m,d0] = ymd.split('-').map(Number); const d = day || d0; const last = new Date(y, m + 1, 0).getDate(); const dt = new Date(y, m, Math.min(d, last)); return dt.getFullYear() + '-' + String(dt.getMonth()+1).padStart(2,'0') + '-' + String(dt.getDate()).padStart(2,'0'); }
