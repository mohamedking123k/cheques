const groupOf = c => c.group || FALLBACK;
const savedGroups = () => readJSON(K_GROUPS(user.username), []);
function saveGroups(list){ writeJSON(K_GROUPS(user.username), list); commit(); scheduleAutoSave(); }
function groups(){
  const g = [...new Set([...savedGroups(), ...checks.map(groupOf)])];
  return g.length ? g : [FALLBACK];
}
function render(){
  const gs = groups();
  if(section !== '__all' && !gs.includes(section)) section = gs.length > 1 ? '__all' : gs[0];
  $('#sections').innerHTML = (gs.length > 1 ? `<button class="sec" aria-pressed="${section==='__all'}" data-g="__all">${t('all_sec')}<small>${checks.length}</small></button>` : '') + gs.map(g => `<button class="sec" aria-pressed="${g===section}" data-g="${esc(g)}">${esc(g)}<small>${checks.filter(c=>groupOf(c)===g).length}</small></button>`).join('') +
    `<span class="sec-tools"><button class="sec-btn" data-gact="add" title="${t('grp_add_t')}">${t('grp_add')}</button><button class="sec-btn" data-gact="rename" title="${t('grp_ren_t')}">${t('grp_ren')}</button><button class="sec-btn" data-gact="del" title="${t('grp_del_t')}">${t('grp_del')}</button></span>`;
  $('#group').innerHTML = gs.map(g=>`<option value="${esc(g)}">${esc(g)}</option>`).join('');
  const all = checks;
  const checksInSec = section === '__all' ? all : all.filter(c => groupOf(c)===section);
  renderSection(checksInSec);
}
function renderSection(checks){
  const pending = checks.filter(c => c.status==='بانتظار الصرف');
  {
    const late = pending.filter(c => daysUntil(c.dueDate) < 0);
    const today = pending.filter(c => daysUntil(c.dueDate) === 0);
    const week = pending.filter(c => { const d = daysUntil(c.dueDate); return d > 0 && d <= 7; });
    const line = (cls, txt, list, act) => list.length ? `<div class="al ${cls}"><span>${txt} <b>${list.length}</b> ${t('in_total')} <b>${sumText(list)}</b></span><button data-alert="${act}">${t('show')}</button></div>` : '';
    $('#alerts').innerHTML =
      line('today', t('al_today'), today, 'today') +
      line('week', t('al_week'), week, 'week') +
      line('late', t('al_late'), late, 'late');
  }
  $('#sPending').textContent = sumText(pending);
  $('#sReturned').textContent = checks.filter(c => c.status==='راجع').length;

  $('#tabs').innerHTML = [...STATUSES,'الكل'].map(s => {
    const n = s==='الكل' ? checks.length : checks.filter(c=>c.status===s).length;
    return `<button class="tab" aria-pressed="${s===filter}" data-f="${s}">${stLabel(s)}<small>${n}</small></button>`;
  }).join('');

  const q = $('#q').value.trim().toLowerCase();
  let list = checks.filter(c => filter==='الكل' || c.status===filter);
  if(q) list = list.filter(c => [c.payee,c.number,c.bank,c.account,c.notes,String(c.amount)].join(' ').toLowerCase().includes(q));
  updateLists();

  // الأشهر: كل شهر لحال، بالأرقام
  const cur = todayYmd().slice(0,7);
  const mName = k => { const [y,m] = k.split('-'); return m + '/' + y; };
  const byMonth = {};
  list.forEach(c => { const k=c.dueDate.slice(0,7); (byMonth[k]=byMonth[k]||[]).push(c); });
  const chipMonths = Object.keys(byMonth).sort();
  if(monthSel !== 'all' && !chipMonths.includes(monthSel)){
    monthSel = chipMonths.includes(cur) ? cur : (chipMonths.find(k => k > cur) || chipMonths[chipMonths.length-1] || '');
  }
  $('#months').innerHTML = `<button class="mchip all" data-month="all" aria-pressed="${monthSel==='all'}"><b>${t('all_months')}</b><span>${t('n_cheques',{n:list.length})}</span></button>` + chipMonths.map(k => `<button class="mchip ${k<cur?'past':''} ${k===cur?'cur':''}" data-month="${k}" aria-pressed="${k===monthSel}"><b>${mName(k)}</b><span>${t('n_cheques',{n:byMonth[k].length})}</span></button>`).join('');
  const act = $('#months [aria-pressed="true"]');
  if(act) act.scrollIntoView({inline:'center', block:'nearest'});

  const isTr = c => TRANSFER_RE.test(c.bank||'');
  const split = items => { const ch = items.filter(c => !isTr(c)), tr = items.filter(isTr); return {ch, tr}; };
  const breakdown = items => {
    const {ch, tr} = split(items), parts = [];
    if(ch.length) parts.push(`${t('cheques')} ${sumText(ch)}`);
    if(tr.length) parts.push(`${t('transfers')} ${sumText(tr)}`);
    if(ch.length && tr.length) parts.push(`<b>${t('total')} ${sumText(items)}</b>`);
    return parts.join(' • ') || '0';
  };
  // הריבוע האמצעי: מה שנשאר לפירעון בחודש הנבחר (יורד כשמסמנים נפרע)
  const setMonthStat = () => {
    const inMonth = checks.filter(c => monthSel === 'all' || c.dueDate.slice(0,7) === monthSel);
    const left = inMonth.filter(c => c.status === 'بانتظار الصرف');
    const done = inMonth.filter(c => c.status === 'انصرف');
    const {ch, tr} = split(left);
    $('#sSoon').textContent = left.length ? sumText(left) : '0';
    const title = monthSel === 'all' ? t('left_all') : monthSel ? t('left_month',{m:mName(monthSel)}) : t('none');
    $('#sSoonLbl').innerHTML = `${title} (${left.length})` +
      `<small class="sub2">${[ch.length?`${t('cheques')} ${sumText(ch)}`:'', tr.length?`${t('transfers')} ${sumText(tr)}`:'', done.length?`${t('s_cashed')} ${sumText(done)}`:''].filter(Boolean).join(' • ')}</small>`;
  };
  if(!list.length){
    setMonthStat();
    $('#list').innerHTML = checks.length
      ? `<div class="empty"><p>${t('empty_sel')}</p></div>`
      : `<div class="empty"><p>${t('empty_grp')}</p><button class="btn btn-main" onclick="openForm()">${t('first_btn')}</button></div>`;
    return;
  }
  const head = (k, items) => `<div class="month">${mName(k)}${k===cur?' <small style="font-family:var(--sans);font-size:.8rem;color:var(--brass)">'+t('this_month')+'</small>':''}<span>${items.length} • ${breakdown(items)}</span></div>`;
  if(monthSel === 'all'){
    setMonthStat();
    $('#list').innerHTML = chipMonths.map(k => head(k, byMonth[k]) + byMonth[k].sort((a,b)=>a.dueDate.localeCompare(b.dueDate)).map(slip).join('')).join('');
    return;
  }
  const items = byMonth[monthSel].sort((a,b)=>a.dueDate.localeCompare(b.dueDate));
  setMonthStat();
  $('#list').innerHTML = head(monthSel, items) + items.map(slip).join('');
}

function slip(c){
  const [,m,d] = c.dueDate.split('-');
  const left = daysUntil(c.dueDate);
  let warn = '';
  if(c.status==='بانتظار الصرف'){
    if(left < 0) warn = `<span class="warn">${t('overdue')}</span>`;
    else if(left === 0) warn = `<span class="warn">${t('due_today')}</span>`;
    else if(left <= 7) warn = `<span class="warn soon">${left===1?t('tomorrow'):t('in_days',{n:left})}</span>`;
  }
  const isT = TRANSFER_RE.test(c.bank||'');
  const where = [isT ? '' : bankHe(c.bank), c.account && (t('account') + ' ' + c.account)].filter(Boolean).join(', ');
  return `<article class="slip ${c.status==='ملغي'?'is-cancelled':''} ${isT?'transfer':''}" data-cid="${esc(c.id)}">
    <div class="stub"><div class="d">${+d}</div><div class="m">${m}/${c.dueDate.slice(0,4)}</div>${c.number?`<div class="no">#${esc(c.number)}</div>`:''}</div>
    <div class="body">
      <div class="row1"><div class="payee">${isT?`<span class="ttag">${esc(bankHe(c.bank))}</span>`:''}${esc(c.payee)}</div><div class="amt">${esc(money(c.amount,c.currency))}</div></div>
      ${where?`<div class="meta">${esc(where)}</div>`:''}
      ${c.notes?`<div class="notes">${esc(c.notes)}</div>`:''}
      <div class="foot">
        <div><span class="badge ${STATUS_CLASS[c.status]||''}">${esc(stLabel(c.status))}</span>${warn}</div>
        <div class="acts">
          ${c.status==='بانتظار الصرف'?`<button data-act="cash" data-id="${esc(c.id)}">${t('b_cash')}</button>`:''}
          ${c.status!=='راجع'&&c.status!=='ملغي'?`<button data-act="ret" data-id="${esc(c.id)}">${t('b_ret')}</button>`:''}
          ${c.status!=='بانتظار الصرف'?`<button data-act="pend" data-id="${esc(c.id)}">${t('b_pend')}</button>`:''}
          <button data-act="edit" data-id="${esc(c.id)}">${t('b_edit')}</button>
          <button data-act="del" data-id="${esc(c.id)}">${t('b_del')}</button>
        </div>
      </div>
    </div>
  </article>`;
}

function updateLists(){
  const uniq = arr => [...new Set(arr.filter(Boolean))];
  $('#payeeList').innerHTML = uniq(checks.map(c=>c.payee)).map(v=>`<option value="${esc(v)}">`).join('');
  $('#bankList').innerHTML = uniq([t('transfer_label'), ...checks.map(c=>bankHe(c.bank)), ...BANKS]).map(v=>`<option value="${esc(v)}">`).join('');
  $('#accountList').innerHTML = uniq(checks.map(c=>c.account)).map(v=>`<option value="${esc(v)}">`).join('');
}

/* ---------- الإضافة والتعديل ---------- */
// המספר הבא = אחרי השיק האחרון שהוזן (לפי סדר ההוספה), לא אחרי השיק האחרון שנערך
function suggestNo(g){
  const withNo = checks.filter(x => (x.group || FALLBACK) === g && /^\d+$/.test(x.number || '') && !TRANSFER_RE.test(x.bank || ''));
  const lastIn = withNo[withNo.length - 1];
  return lastIn ? String(+lastIn.number + 1).padStart(lastIn.number.length, '0') : '';
}
function openForm(id){
  const c = checks.find(x => x.id===id);
  editingId = c ? c.id : '';
  $('#dlgTitle').textContent = c ? t('edit_cheque') : t('new_cheque');
  $('#err').textContent = '';
  const g0 = section === '__all' ? groups()[0] : section;
  const last = [...checks].filter(x => (x.group || FALLBACK) === g0).sort((a,b)=>(b.updated||'').localeCompare(a.updated||''))[0];
  const nextNo = c ? '' : suggestNo(g0);
  const v = c || {payee:'',amount:'',currency:last?.currency||'₪',dueDate:'',issueDate:todayYmd(),bank:last?.bank||'',account:last?.account||'',number:nextNo,status:'بانتظار الصرف',notes:'',group:g0};
  FIELDS.forEach(k => $('#'+k).value = (k==='dueDate'||k==='issueDate') ? fmtDate(v[k]) : (v[k] ?? ''));
  document.querySelectorAll('#form .dtext').forEach(el => el.classList.remove('bad'));
  if(c && !c.group) $('#group').value = FALLBACK;
  $('#dlg').showModal();
  setTimeout(()=>$('#payee').focus(), 50);
}

function cleanRec(d){
  const s = (v,max=200) => String(v ?? '').trim().slice(0,max);
  const ymd = v => /^\d{4}-\d{2}-\d{2}$/.test(v||'') ? v : '';
  return {
    payee:s(d.payee), amount:Math.round(Number(d.amount)*100)/100, currency:s(d.currency,5)||'₪',
    dueDate:ymd(d.dueDate), issueDate:ymd(d.issueDate), bank:s(d.bank), account:s(d.account,60),
    number:s(d.number,40), status:STATUSES.includes(d.status)?d.status:STATUSES[0],
    notes:s(d.notes,1000), group:s(d.group,40)||FALLBACK, updated:new Date().toISOString()
  };
}

$('#form').addEventListener('submit', e => {
  e.preventDefault();
  const data = {}; FIELDS.forEach(k => data[k] = $('#'+k).value);
  const errEl = $('#err');
  data.dueDate = parseDate(data.dueDate); data.issueDate = parseDate(data.issueDate) || '';
  if(!data.payee.trim()) return errEl.textContent = t('e_payee');
  if(!(+data.amount > 0)) return errEl.textContent = t('e_amount');
  if(data.dueDate === null){ $('#dueDate').classList.add('bad'); return errEl.textContent = t('e_date_bad'); }
  if(!data.dueDate) return errEl.textContent = t('e_due');
  const rec = cleanRec(data);
  if(rec.number){ const dup = checks.find(x => x.id !== editingId && x.number === rec.number && (x.group || FALLBACK) === rec.group); if(dup && !confirm(t('dup_no',{n:rec.number, p:dup.payee}))) return; }
  const id = editingId || newId();
  if(editingId){ const i = checks.findIndex(c => c.id===editingId); checks[i] = {...rec, id}; }
  else checks.push({...rec, id});
  if(!persist()) return;
  // ودّي الشاشة على شهر الشيك، وبيترتب لحاله حسب التاريخ
  const k = rec.dueDate.slice(0,7), cur = todayYmd().slice(0,7);
  if(section !== '__all') section = rec.group || section;
  if(filter !== 'الكل' && filter !== rec.status) filter = rec.status;
  if(monthSel !== 'all') monthSel = k;
  $('#dlg').close(); render();
  const el = document.querySelector(`.slip[data-cid="${CSS.escape(id)}"]`);
  if(el){ el.scrollIntoView({behavior:'smooth', block:'center'}); el.classList.add('flash'); setTimeout(()=>el.classList.remove('flash'), 1800); }
  const [yy,mm] = k.split('-');
  toast(t(editingId ? 't_edited' : 't_saved', {m: mm + '/' + yy}));
});

$('#list').addEventListener('click', e => {
  const b = e.target.closest('button[data-act]'); if(!b) return;
  const c = checks.find(x => x.id===b.dataset.id); if(!c) return;
  if(b.dataset.act==='edit') return openForm(c.id);
  if(b.dataset.act==='cash'){ c.status = 'انصرف'; c.updated = new Date().toISOString(); persist(); render(); toast(t('t_cashed')); }
  if(b.dataset.act==='ret'){
    if(!confirm(t('ret_confirm',{p:c.payee, a:money(c.amount,c.currency)}))) return;
