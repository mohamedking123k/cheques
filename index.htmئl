<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title data-i18n="app">פנקס שיקים</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧾</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@500;700&family=Heebo:wght@400;500;600&family=Amiri:wght@400;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#0F3B2E; --ink-2:#1B5442; --paper:#EEF2EC; --slip:#FBFCF8; --brass:#9C7A2E;
  --text:#17241E; --muted:#5E6E66; --line:#D3DCD4; --stamp:#9E2B25; --ok:#2F6B4F;
  --serif:'Frank Ruhl Libre','David',serif;
  --sans:'Heebo','Segoe UI',Arial,sans-serif;
  color-scheme:light;
}
:root[lang="ar"]{--serif:'Amiri','Frank Ruhl Libre',serif;--sans:'IBM Plex Sans Arabic','Heebo',Tahoma,sans-serif}
:root[lang="en"]{--serif:'Frank Ruhl Libre',Georgia,serif;--sans:'Heebo','Segoe UI',Arial,sans-serif}
@media (prefers-color-scheme: dark){
  :root{
    --paper:#0D1813; --slip:#15241D; --text:#E5ECE7; --muted:#9AABA2; --line:#2B3D34;
    --ink:#0A2A20; --ink-2:#5DA585; --brass:#CDA85C; --stamp:#E4706A; --ok:#72C49D;
    color-scheme:dark;
  }
}
*{box-sizing:border-box}
html,body{min-height:100%}
body{margin:0;background:var(--paper);color:var(--text);font-family:var(--sans);font-size:16px;line-height:1.6;padding-bottom:env(safe-area-inset-bottom,0px)}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--brass);outline-offset:2px}
.wrap{max-width:860px;margin:0 auto}
[hidden]{display:none!important}
.guilloche{
  background-color:var(--ink);color:#F2EBD6;
  background-image:repeating-radial-gradient(circle at 100% 0,rgba(255,255,255,.045) 0 1px,transparent 1px 8px);
}

/* ===== شاشة الدخول ===== */
#authView{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:calc(24px + env(safe-area-inset-top,0px)) 16px 24px}
.auth-card{width:min(420px,100%);background:var(--slip);color:var(--text);border-radius:12px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.35)}
.auth-head{padding:26px 24px 18px}
.auth-head h1{font-family:var(--serif);font-size:2.4rem;margin:0;line-height:1.15}
.auth-head p{margin:2px 0 0;color:#BFD0C6}
.auth-tabs{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--line)}
.auth-tabs button{background:none;border:0;padding:12px;cursor:pointer;color:var(--muted);border-bottom:2px solid transparent}
.auth-tabs button[aria-selected="true"]{color:var(--text);font-weight:600;border-bottom-color:var(--brass)}
.auth-body{padding:20px 24px 24px}
.link{background:none;border:0;padding:0;color:var(--muted);text-decoration:underline;cursor:pointer;font-size:.88rem;margin-top:12px}
.setup{padding:20px 24px;font-size:.92rem}
.setup code{background:var(--paper);padding:1px 6px;border-radius:4px;direction:ltr;display:inline-block}

/* ===== التطبيق ===== */
header.top{padding:calc(22px + env(safe-area-inset-top,0px)) 20px 22px}
.head-row{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
h1.title{font-family:var(--serif);font-weight:700;font-size:2.4rem;margin:0;line-height:1.15}
.sub{color:#BFD0C6;margin:2px 0 18px;font-size:.95rem}
.head-acts{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.hint{font-size:.82rem;color:var(--muted);margin:10px 0 0}
.out-save{background:#E8D6A2!important;color:#0F3B2E!important;border-color:#E8D6A2!important;font-weight:600}
.fs{margin:-12px 0 14px;font-size:.82rem;color:#BFD0C6;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.fs:empty{display:none}
.ver{position:absolute;top:calc(6px + env(safe-area-inset-top,0px));left:10px;margin:0;font-size:.7rem;color:rgba(242,235,214,.45)}
header.top{position:relative}
.fs .dot{width:8px;height:8px;border-radius:50%;background:#7BD4A6;display:inline-block}
.fs .dot.off{background:#E4A35A}
.fs button{background:none;border:0;color:#E8D6A2;text-decoration:underline;cursor:pointer;padding:0;font-size:.82rem}
.langSel{background:transparent;color:#F2EBD6;border:1px solid rgba(255,255,255,.3);border-radius:8px;padding:5px 8px;font-size:.85rem;cursor:pointer}
.langSel option{color:#17241E}
.auth-lang{display:flex;justify-content:flex-end;margin-bottom:8px}
.out{background:transparent;border:1px solid rgba(255,255,255,.3);color:#F2EBD6;border-radius:8px;padding:6px 12px;cursor:pointer;font-size:.85rem;white-space:nowrap}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.14);border-radius:8px;overflow:hidden}
.stat{background:var(--ink);padding:12px 14px}
.stat b{display:block;font-family:var(--serif);font-size:1.45rem;color:#E8D6A2;line-height:1.35}
.stat .sub2{display:block;font-size:.75rem;opacity:.85;margin-top:2px}
.stat span{font-size:.82rem;color:#BFD0C6}

main{padding:18px 20px 60px}
.bar{display:flex;gap:10px;align-items:center;margin-bottom:12px;flex-wrap:wrap}
.search{flex:1;min-width:0;padding:10px 14px;border:1px solid var(--line);border-radius:8px;background:var(--slip)}
.btn{border:0;border-radius:8px;padding:10px 18px;cursor:pointer;font-weight:600;white-space:nowrap}
.btn:disabled{opacity:.6;cursor:default}
.btn-main{background:var(--ink-2);color:#fff}
@media (prefers-color-scheme: dark){.btn-main{color:#0D1813}}
.btn-ghost{background:transparent;border:1px solid var(--line)}
.btn-wide{width:100%;margin-top:6px}
.alerts{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}
.alerts:empty{display:none}
.al{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;padding:10px 14px;border-radius:8px;border:1px solid var(--line);background:var(--slip);font-size:.93rem}
.al b{font-weight:600}
.al.late{border-color:var(--stamp);border-inline-start:4px solid var(--stamp)}
.al.today{border-inline-start:4px solid var(--brass)}
.al.week{border-inline-start:4px solid var(--ok)}
.al button{background:none;border:1px solid var(--line);border-radius:6px;padding:3px 10px;cursor:pointer;font-size:.82rem;white-space:nowrap}
.sections{display:flex;gap:4px;margin-bottom:14px;border-bottom:1px solid var(--line);overflow-x:auto}
.sec{background:none;border:0;border-bottom:3px solid transparent;padding:8px 16px;cursor:pointer;font-family:var(--serif);font-size:1.25rem;font-weight:700;color:var(--muted);white-space:nowrap}
.sec[aria-pressed="true"]{color:var(--text);border-bottom-color:var(--brass)}
.sec-tools{display:flex;gap:4px;align-items:center;margin-inline-start:auto;padding-inline-start:12px}
.sec-btn{background:none;border:1px dashed var(--line);border-radius:6px;padding:3px 10px;cursor:pointer;font-size:.8rem;color:var(--muted);white-space:nowrap}
.sec-btn:hover{color:var(--text);border-color:var(--muted)}
.sec small{font-family:var(--sans);font-size:.78rem;font-weight:500;margin-inline-start:4px}
.zoom{display:flex;align-items:center;gap:6px;padding:6px 10px;border:1px solid var(--line);border-radius:8px;background:var(--slip);font-size:.8rem;color:var(--muted);cursor:pointer}
.zoom .zs{font-size:.7rem}.zoom .zl{font-size:1.05rem}
.zoom input{width:110px;accent-color:var(--ink-2)}
.zoom output{min-width:3.2em;text-align:center;font-variant-numeric:tabular-nums}
#list{zoom:var(--z,1)}
.months{display:flex;gap:8px;overflow-x:auto;padding:10px 0 6px;scroll-snap-type:x proximity}
.mchip{flex:none;scroll-snap-align:start;border:1px solid var(--line);background:var(--slip);border-radius:8px;padding:6px 12px;cursor:pointer;text-align:center;line-height:1.3;min-width:96px}
.mchip b{display:block;font-family:var(--serif);font-size:1.02rem}
.mchip span{display:block;font-size:.75rem;color:var(--muted)}
.mchip.past{opacity:.6}
.mchip.all{position:sticky;inset-inline-start:0;z-index:1;box-shadow:-8px 0 10px -6px rgba(0,0,0,.18)}
.mchip.cur{border-color:var(--brass)}
.mchip[aria-pressed="true"]{background:var(--ink-2);border-color:var(--ink-2);color:#fff;opacity:1}
.mchip[aria-pressed="true"] span{color:inherit;opacity:.85}
@media (prefers-color-scheme: dark){.mchip[aria-pressed="true"]{color:#0D1813}}
.slip.flash{box-shadow:0 0 0 3px var(--brass);transition:box-shadow .6s}
.past{margin-top:28px;border:1px solid var(--line);border-radius:8px;background:var(--slip)}
.past summary{cursor:pointer;padding:10px 14px;color:var(--muted);font-size:.92rem;list-style:none;display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}
.past summary::-webkit-details-marker{display:none}
.past summary b{color:var(--text);font-weight:600}
.past summary::before{content:'◂';margin-inline-end:6px}
.past[open] summary::before{content:'▾'}
.pm{border-top:1px solid var(--line);padding:6px 14px 10px}
.pm-head{display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin:6px 0 4px}
.pm-head button{background:none;border:0;padding:0;font-family:var(--serif);font-weight:700;font-size:1.05rem;color:var(--text);cursor:pointer;text-decoration:underline;text-decoration-color:var(--line);text-underline-offset:4px}
.pm-head span{font-size:.82rem;color:var(--muted)}
.mini{display:grid;grid-template-columns:3.2em 1fr auto;gap:2px 10px;font-size:.85rem;padding:3px 0;color:var(--muted)}
.mini .p{color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mini .a{direction:ltr;color:var(--text)}
.mini.late .p::after{content:' • עדיין לא נפרע';color:var(--stamp);font-size:.78rem}
.back{background:none;border:1px solid var(--line);border-radius:999px;padding:4px 12px;cursor:pointer;font-size:.85rem;margin-top:14px}
.tabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px}
.tab{border:1px solid var(--line);background:transparent;border-radius:999px;padding:5px 14px;white-space:nowrap;cursor:pointer;font-size:.9rem}
.tab[aria-pressed="true"]{background:var(--text);color:var(--paper);border-color:var(--text)}
.tab small{opacity:.7;margin-inline-start:4px}

.month{font-family:var(--serif);font-size:1.35rem;font-weight:700;margin:24px 0 8px;display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid var(--line);padding-bottom:4px}
.month span{font-family:var(--sans);font-size:.85rem;font-weight:500;color:var(--muted)}

.slip{display:grid;grid-template-columns:92px 1fr;background:var(--slip);border:1px solid var(--line);border-radius:6px;margin-bottom:10px}
.stub{border-inline-end:2px dashed var(--line);padding:12px 6px;text-align:center;display:flex;flex-direction:column;justify-content:center}
.stub .d{font-family:var(--serif);font-size:2rem;font-weight:700;line-height:1}
.stub .m{font-size:.8rem;color:var(--muted)}
.stub .no{font-size:.75rem;color:var(--muted);margin-top:6px;direction:ltr}
.body{padding:12px 16px;min-width:0}
.row1{display:flex;justify-content:space-between;gap:12px;align-items:baseline}
.payee{font-weight:600;font-size:1.05rem;overflow-wrap:anywhere}
.amt{font-family:var(--serif);font-size:1.6rem;font-weight:700;white-space:nowrap;direction:ltr}
.meta{color:var(--muted);font-size:.88rem}
.notes{font-size:.88rem;margin-top:4px;white-space:pre-wrap}
.foot{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between;margin-top:8px}
.badge{font-size:.78rem;padding:2px 10px;border-radius:999px;border:1px solid currentColor;color:var(--brass)}
.badge.cashed{color:var(--ok)} .badge.returned{color:var(--stamp)} .badge.cancelled{color:var(--muted)}
.warn{font-size:.78rem;color:var(--stamp);font-weight:600;margin-inline-start:8px}
.soon{color:var(--brass)}
.slip.transfer{border-inline-start:4px solid var(--stamp)}
.ttag{display:inline-block;font-size:.72rem;font-weight:600;color:#fff;background:var(--stamp);border-radius:4px;padding:1px 8px;margin-inline-end:8px;vertical-align:middle}
@media (prefers-color-scheme: dark){.ttag{color:#0D1813}}
.slip.is-cancelled .amt{text-decoration:line-through;opacity:.6}
.acts{display:flex;gap:4px}
.acts button{background:transparent;border:0;padding:4px 8px;border-radius:6px;cursor:pointer;color:var(--muted);font-size:.85rem}
.acts button:hover{background:var(--paper);color:var(--text)}
.empty{text-align:center;color:var(--muted);padding:48px 12px}
.empty p{margin:0 0 12px}

dialog{border:0;border-radius:10px;padding:0;width:min(560px,94vw);background:var(--slip);color:var(--text);box-shadow:0 18px 50px rgba(0,0,0,.35)}
dialog::backdrop{background:rgba(8,20,15,.55)}
.dlg-head{padding:14px 20px;font-family:var(--serif);font-size:1.5rem;font-weight:700}
form.f-form{padding:18px 20px 20px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px 14px}
.dwrap{display:flex;gap:6px;position:relative}
.dwrap .dtext{flex:1;min-width:0;direction:ltr;text-align:start}
.dpick{flex:none;border:1px solid var(--line);background:var(--paper);border-radius:7px;padding:0 10px;cursor:pointer;font-size:1rem}
.dnative{position:absolute;inset-inline-end:0;bottom:0;width:1px;height:1px;opacity:0;pointer-events:none;border:0;padding:0}
.bad{border-color:var(--stamp)!important;background:rgba(158,43,37,.06)!important}
#bulk{width:min(900px,96vw)}
.bulk-shared{display:grid;grid-template-columns:repeat(3,1fr);gap:10px 12px;margin-bottom:12px}
.bulk-rows{display:flex;flex-direction:column;gap:8px;max-height:52vh;overflow:auto;padding:2px}
.brow{display:grid;grid-template-columns:minmax(150px,1.1fr) 1.5fr .9fr .8fr 1.1fr auto;gap:8px;align-items:center}
.brow input{width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:7px;background:var(--paper)}
.brow .x{background:none;border:0;color:var(--muted);cursor:pointer;font-size:1.1rem;padding:4px 6px}
.bhead{display:grid;grid-template-columns:minmax(150px,1.1fr) 1.5fr .9fr .8fr 1.1fr auto;gap:8px;font-size:.78rem;color:var(--muted);padding:0 2px}
.bulk-tools{display:flex;gap:8px;margin:10px 0 0;flex-wrap:wrap}
.bulk-hint{font-size:.82rem;color:var(--muted);margin:6px 0 0}
.btn:disabled{opacity:.45;cursor:default}
@media (max-width:640px){.bulk-shared{grid-template-columns:1fr}.brow,.bhead{grid-template-columns:1fr 1fr}.bhead{display:none}.brow .x{justify-self:end}}
.full{grid-column:1/-1}
label{display:block;font-size:.85rem;color:var(--muted);margin-bottom:4px}
.f{margin-bottom:12px}
.grid .f{margin-bottom:0}
.f input,.f select,.f textarea{width:100%;padding:9px 12px;border:1px solid var(--line);border-radius:7px;background:var(--paper)}
.f .big{font-family:var(--serif);font-size:1.4rem;font-weight:700;padding:4px 12px}
.amount-row{display:flex;gap:8px}.amount-row select{width:84px;flex:none}
.err{color:var(--stamp);font-size:.9rem;min-height:1.4em;margin:10px 0 0}
.ok-msg{color:var(--ok)}
.dlg-acts{display:flex;gap:10px;justify-content:flex-start;margin-top:8px}

.toast{position:fixed;bottom:calc(20px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%) translateY(20px);opacity:0;background:var(--text);color:var(--paper);padding:10px 18px;border-radius:8px;transition:.25s;pointer-events:none;z-index:20}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

@media (max-width:560px){
  h1.title{font-size:2rem}
  .stats{grid-template-columns:1fr}
  .grid{grid-template-columns:1fr}
  .slip{grid-template-columns:72px 1fr}
  .amt{font-size:1.35rem}
  .row1{flex-direction:column;gap:0}
}
@media (prefers-reduced-motion: reduce){.toast{transition:none}}

.modebar{display:flex;gap:4px;justify-content:center;padding:8px 12px calc(8px) ;background:#0B1F17;border-bottom:1px solid rgba(255,255,255,.08);padding-top:calc(8px + env(safe-area-inset-top,0px))}
.modebar button{background:transparent;color:#C9D7CE;border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:6px 18px;cursor:pointer;font-weight:600;font-size:.92rem}
.modebar button[aria-pressed="true"]{background:#E8D6A2;color:#0F3B2E;border-color:#E8D6A2}
#inApp{background:var(--paper);color:var(--text);min-height:100vh}
#inApp .langSel{display:inline-block}

/* ===== שיקים נכנסים ===== */
