$('#restoreFile').addEventListener('change', async e => {
  const file = e.target.files[0]; e.target.value = '';
  if(!file) return;
  try{
    const data = JSON.parse(await file.text());
    const list = Array.isArray(data) ? data : data.checks;
    if(!Array.isArray(list)) throw 0;
    const valid = list.filter(c => c && c.payee && c.dueDate && +c.amount > 0).map(c => ({rec: {...cleanRec(c), id: c.id || newId(), updated: c.updated || new Date().toISOString()}, hasGroup: !!c.group}));
    if(!confirm(t('restore_confirm',{n:valid.length}))) return;
    const byId = new Map(checks.map(c => [c.id, c]));
    let added = 0, moved = 0;
    valid.forEach(({rec: c, hasGroup}) => {
      const old = byId.get(c.id);
      if(!old){ checks.push(c); added++; }
      else if(hasGroup && old.group !== c.group && (!old.group || old.updated === c.updated)){ old.group = c.group; moved++; }   // تصليح الخانة للشيكات اللي نزلت قبل وما انعدّلت
    });
    persist(); render();
    toast(added ? t('restore_added',{n:added}) + (moved ? ', ' + t('restore_moved',{n:moved}) : '') : (moved ? t('restore_moved',{n:moved}) : t('restore_exists')));
  }catch(err){ toast(t('restore_bad')); }
});

