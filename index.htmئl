function slip(c){
  const [, m, d] = c.dueDate.split('-'), left = daysUntil(c.dueDate);
  let warn = '';
  if(c.status === 'held'){
    if(left < 0) warn = `<span class="warn">${esc(t('overdue'))}</span>`;
    else if(left === 0) warn = `<span class="warn">${esc(t('due_today'))}</span>`;
    else if(left <= 7) warn = `<span class="warn soon">${esc(left === 1 ? t('tomorrow') : t('in_days',{n:left}))}</span>`;
  }
  const bankLine = [c.bank, c.branch && (t('branch') + ' ' + c.branch), c.account && (t('acc') + ' ' + c.account)].filter(Boolean).join(' • ');
  const sent = (c.smsSent ? `<span class="sent">${esc(t('sms_sent',{d:fmtDate(c.smsSent.slice(0,10))}))}</span>` : '') + (c.notified ? `<span class="sent">${esc(t('sent',{d:fmtDate(c.notified.slice(0,10))}))}</span>` : '');
  const btn = (a, k, cls='') => `<button class="${cls}" data-act="${a}" data-id="${esc(c.id)}">${esc(t(k))}</button>`;
  let acts = '';
  if(c.status === 'held') acts += btn('deposited','b_deposit') + btn('passed','b_pass');
  if(['held','deposited','passed'].includes(c.status)) acts += btn('cleared','b_clear') + btn('returned','b_return');
  if(c.status === 'returned') acts += btn('notify','b_notify','wa');
  if(c.status !== 'held') acts += btn('held','b_back');
  acts += btn('edit','b_edit') + btn('del','b_del');
  return `<article class="slip st-${c.status}" data-cid="${esc(c.id)}">
    <div class="stub"><div class="d">${+d}</div><div class="m">${m}/${c.dueDate.slice(0,4)}</div>${c.number?`<div class="no">#${esc(c.number)}</div>`:''}</div>
    <div class="body">
      <div class="row1"><div class="cust">${esc(t('from'))}${esc(c.customer)}${c.purpose?` <span class="ptag p-${c.purpose}">${esc(t('p_'+c.purpose))}</span>`:''}</div><div class="amt">${esc(money(c.amount,c.currency))}</div></div>
      ${bankLine?`<div class="meta">${esc(bankLine)}</div>`:''}
      ${c.drawer?`<div class="meta">${esc(t('drawer'))} <b>${esc(c.drawer)}</b></div>`:''}
      ${c.passedTo?`<div class="meta">${esc(t('to_whom'))}<b>${esc(c.passedTo)}</b>${c.passedDate?` ${esc(t('on_date'))} <b>${fmtDate(c.passedDate)}</b>`:''}</div>`:''}
      ${c.status==='returned' && c.reason?`<div class="meta" style="color:var(--stamp)">${esc(t('f_reason'))}: ${esc(c.reason)}</div>`:''}
      ${c.phone?`<div class="meta" dir="ltr" style="text-align:start">📞 ${esc(c.phone)}</div>`:''}
      ${c.notes?`<div class="notes">${esc(c.notes)}</div>`:''}
      <div class="foot"><div><span class="badge ${c.status}">${esc(t('s_'+c.status))}</span>${warn}${sent}</div><div class="acts2">${acts}</div></div>
    </div>
  </article>`;
}
