  else el.innerHTML = `<span class="dot"></span>${esc(t('fs_ok'))} <b>${esc(fileHandle.name)}</b>${lastSaved ? ' • ' + hhmm(lastSaved) : ''} <button id="fsChange">${esc(t('fs_change'))}</button>`;
}
async function writeFile(ask){
  if(!fileHandle) return false;
  if(!(await perm(fileHandle, ask))){ fsStatus('need'); return false; }
  try{ const w = await fileHandle.createWritable(); await w.write(new Blob([backupData()], {type:'application/json'})); await w.close(); lastSaved = new Date(); fsStatus('ok'); return true; }
  catch(e){ fsStatus('need'); return false; }
}
function scheduleAutoSave(){ if(!fileHandle) return; clearTimeout(autoTimer); autoTimer = setTimeout(() => writeFile(false), 1200); }
