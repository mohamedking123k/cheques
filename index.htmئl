}
const accounts = () => readJSON(K_ACCOUNTS, {});
let undoStack = [], redoStack = [], curState = '';
const stateNow = () => JSON.stringify({checks, groups: readJSON(K_GROUPS(user.username), [])});
function resetHistory(){ undoStack = []; redoStack = []; curState = stateNow(); updUndo(); }
function commit(){ const now = stateNow(); if(now === curState) return; undoStack.push(curState); if(undoStack.length > 60) undoStack.shift(); redoStack = []; curState = now; updUndo(); }
function updUndo(){ const u = $('#undoBtn'), r = $('#redoBtn'); if(u) u.disabled = !undoStack.length; if(r) r.disabled = !redoStack.length; }
function applyState(str){ const st = JSON.parse(str); checks = st.checks; writeJSON(K_DATA(user.username), checks); writeJSON(K_GROUPS(user.username), st.groups || []); curState = str; scheduleAutoSave(); render(); updUndo(); }
function undo(){ if(!user) return; if(!undoStack.length) return toast(t('nothing_undo')); redoStack.push(curState); applyState(undoStack.pop()); toast(t('undone')); }
function redo(){ if(!user) return; if(!redoStack.length) return toast(t('nothing_redo')); undoStack.push(curState); applyState(redoStack.pop()); toast(t('redone')); }
function persist(){ const ok = writeJSON(K_DATA(user.username), checks); if(ok){ commit(); scheduleAutoSave(); } return ok; }

