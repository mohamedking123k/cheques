#inApp .bar{display:flex;gap:10px;align-items:center;margin-bottom:12px;flex-wrap:wrap}
#inApp .search{flex:1;min-width:180px;padding:10px 14px;border:1px solid var(--line);border-radius:8px;background:var(--slip)}
#inApp .btn{border:0;border-radius:8px;padding:10px 18px;cursor:pointer;font-weight:600;white-space:nowrap}
#inApp .btn:disabled{opacity:.45;cursor:default}
#inApp .btn-main{background:var(--ink-2);color:#fff}
@media (prefers-color-scheme: dark){#inApp .btn-main{color:#0C141C}}
#inApp .btn-ghost{background:transparent;border:1px solid var(--line)}
#inApp .btn-wa{background:#1F8F55;color:#fff}
#inApp .btn-wide{width:100%;margin-top:6px}
#inApp .tabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px}
#inApp .tab{border:1px solid var(--line);background:transparent;border-radius:999px;padding:5px 14px;white-space:nowrap;cursor:pointer;font-size:.9rem}
#inApp .tab[aria-pressed="true"]{background:var(--text);color:var(--paper);border-color:var(--text)}
#inApp .tab small{opacity:.7;margin-inline-start:4px}
#inApp .months{display:flex;gap:8px;overflow-x:auto;padding:10px 0 6px}
#inApp .mchip{flex:none;border:1px solid var(--line);background:var(--slip);border-radius:8px;padding:6px 12px;cursor:pointer;text-align:center;line-height:1.3;min-width:92px}
#inApp .mchip b{display:block;font-family:var(--serif);font-size:1.02rem}
#inApp .mchip span{display:block;font-size:.75rem;color:var(--muted)}
#inApp .mchip.past{opacity:.6}
#inApp .mchip.cur{border-color:var(--brass)}
#inApp .mchip.all{position:sticky;inset-inline-start:0;z-index:1}
#inApp .mchip[aria-pressed="true"]{background:var(--ink-2);border-color:var(--ink-2);color:#fff;opacity:1}
#inApp .mchip[aria-pressed="true"] span{color:inherit;opacity:.85}
@media (prefers-color-scheme: dark){#inApp .mchip[aria-pressed="true"]{color:#0C141C}}
#inApp .month{font-family:var(--serif);font-size:1.3rem;font-weight:700;margin:22px 0 8px;display:flex;justify-content:space-between;align-items:baseline;gap:10px;border-bottom:1px solid var(--line);padding-bottom:4px;flex-wrap:wrap}
#inApp .month span{font-family:var(--sans);font-size:.85rem;font-weight:500;color:var(--muted)}
#inApp .slip{display:grid;grid-template-columns:92px 1fr;background:var(--slip);border:1px solid var(--line);border-radius:6px;margin-bottom:10px}
#inApp .slip.st-returned{border-inline-start:4px solid var(--stamp)}
#inApp .slip.st-passed{border-inline-start:4px solid var(--blue)}
#inApp .slip.flash{box-shadow:0 0 0 3px var(--brass);transition:box-shadow .6s}
#inApp .stub{border-inline-end:2px dashed var(--line);padding:12px 6px;text-align:center;display:flex;flex-direction:column;justify-content:center}
#inApp .stub .d{font-family:var(--serif);font-size:2rem;font-weight:700;line-height:1}
#inApp .stub .m{font-size:.8rem;color:var(--muted)}
#inApp .stub .no{font-size:.75rem;color:var(--muted);margin-top:6px;direction:ltr}
#inApp .body{padding:12px 16px;min-width:0}
#inApp .row1{display:flex;justify-content:space-between;gap:12px;align-items:baseline}
#inApp .chips{display:flex;flex-wrap:wrap;gap:6px;max-height:42vh;overflow:auto;margin-top:10px}
#inApp .chip{border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:5px 12px;cursor:pointer;font-size:.9rem}
#inApp .chip:hover{border-color:var(--ink-2);color:var(--ink-2)}
#inApp .ptag{display:inline-block;font-size:.74rem;font-weight:600;border-radius:4px;padding:1px 8px;margin-inline-start:6px;vertical-align:middle;background:var(--paper);border:1px solid var(--line);color:var(--muted)}
#inApp .ptag.p-debt{background:#FBEBD3;border-color:#E9C98F;color:#7A5413}
#inApp .ptag.p-purchase{background:#DDEBF7;border-color:#A9C7E6;color:#1E4B75}
#inApp .cust{font-weight:600;font-size:1.05rem;overflow-wrap:anywhere}
#inApp .amt{font-family:var(--serif);font-size:1.6rem;font-weight:700;white-space:nowrap;direction:ltr}
#inApp .meta{color:var(--muted);font-size:.86rem;overflow-wrap:anywhere}
#inApp .meta b{color:var(--text);font-weight:600}
#inApp .notes{font-size:.86rem;margin-top:4px;white-space:pre-wrap}
#inApp .foot{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between;margin-top:8px}
#inApp .badge{font-size:.78rem;padding:2px 10px;border-radius:999px;border:1px solid currentColor;color:var(--brass)}
#inApp .badge.deposited{color:var(--blue)}
#inApp .badge.passed{color:var(--blue)}
#inApp .badge.cleared{color:var(--ok)}
#inApp .badge.returned{color:var(--stamp)}
#inApp .badge.cancelled{color:var(--muted)}
#inApp .warn{font-size:.78rem;color:var(--stamp);font-weight:600;margin-inline-start:8px}
#inApp .warn.soon{color:var(--brass)}
#inApp .sent{font-size:.78rem;color:var(--ok);margin-inline-start:8px}
#inApp .acts2{display:flex;gap:2px;flex-wrap:wrap}
#inApp .acts2 button{background:transparent;border:0;padding:4px 8px;border-radius:6px;cursor:pointer;color:var(--muted);font-size:.85rem}
#inApp .acts2 button:hover{background:var(--paper);color:var(--text)}
#inApp .acts2 button.wa{color:#fff;background:#1F8F55}
#inApp .empty{text-align:center;color:var(--muted);padding:48px 12px}
#inApp .empty p{margin:0 0 12px}
#inApp dialog{border:0;border-radius:10px;padding:0;width:min(620px,95vw);background:var(--slip);color:var(--text);box-shadow:0 18px 50px rgba(0,0,0,.35)}
#inApp dialog::backdrop{background:rgba(8,16,26,.55)}
#inApp .dlg-head{padding:14px 20px;font-family:var(--serif);font-size:1.45rem;font-weight:700}
#inApp .ff{padding:18px 20px 20px}
#inApp .grid{display:grid;grid-template-columns:1fr 1fr;gap:12px 14px}
#inApp .full{grid-column:1/-1}
#inApp .sec-t{grid-column:1/-1;font-size:.78rem;font-weight:600;letter-spacing:.02em;color:var(--brass);margin:6px 0 -6px;border-top:1px solid var(--line);padding-top:10px}
#inApp label{display:block;font-size:.85rem;color:var(--muted);margin-bottom:4px}
#inApp .f input,#inApp .f select,#inApp .f textarea{width:100%;padding:9px 12px;border:1px solid var(--line);border-radius:7px;background:var(--paper)}
#inApp .f .big{font-family:var(--serif);font-size:1.4rem;font-weight:700;padding:4px 12px}
#inApp .amount-row{display:flex;gap:8px}
#inApp .amount-row select{width:84px;flex:none}
#inApp .dwrap{display:flex;gap:6px;position:relative}
#inApp .dwrap .dtext{flex:1;min-width:0;direction:ltr;text-align:start}
#inApp .dpick{flex:none;border:1px solid var(--line);background:var(--paper);border-radius:7px;padding:0 10px;cursor:pointer}
#inApp .dnative{position:absolute;inset-inline-end:0;bottom:0;width:1px;height:1px;opacity:0;pointer-events:none;border:0;padding:0}
#inApp .bad{border-color:var(--stamp)!important;background:rgba(163,48,42,.06)!important}
#inApp .err{color:var(--stamp);font-size:.9rem;min-height:1.4em;margin:10px 0 0}
#inApp .dlg-acts{display:flex;gap:10px;justify-content:flex-start;margin-top:8px;flex-wrap:wrap}
#inApp .msg-langs{display:flex;gap:6px;margin-bottom:8px}
#inApp .msg-langs button{border:1px solid var(--line);background:transparent;border-radius:6px;padding:3px 10px;cursor:pointer}
#inApp .msg-langs button[aria-pressed="true"]{background:var(--text);color:var(--paper)}
#inApp #in-msgText{width:100%;min-height:140px;padding:10px 12px;border:1px solid var(--line);border-radius:7px;background:var(--paper)}
#inApp .toast{position:fixed;bottom:calc(20px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%) translateY(20px);opacity:0;background:var(--text);color:var(--paper);padding:10px 18px;border-radius:8px;transition:.25s;pointer-events:none;z-index:20;max-width:92vw;text-align:center}
#inApp .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
@media (max-width:600px){#inApp h1.title{font-size:1.9rem}#inApp .stats{grid-template-columns:1fr}#inApp .grid{grid-template-columns:1fr}#inApp .slip{grid-template-columns:72px 1fr}#inApp .amt{font-size:1.35rem}#inApp .row1{flex-direction:column;gap:0}}
@media (prefers-reduced-motion: reduce){#inApp .toast,#inApp .slip.flash{transition:none}}
</style>
</head>
<body>

<!-- ===== شاشة الدخول ===== -->
<section id="authView" class="guilloche" hidden>
  <div class="auth-card">
    <div class="auth-head guilloche">
      <div class="auth-lang"><select class="langSel" id="langSel1" aria-label="Language"><option value="he">עברית</option><option value="ar">العربية</option><option value="en">English</option></select></div>
      <h1 data-i18n="app">פנקס שיקים</h1>
      <p data-i18n="tagline">כל שיק שיוצא, למי ומאיזה חשבון</p>
    </div>

    <div id="authBox">
      <div class="auth-tabs" role="tablist">
        <button type="button" role="tab" aria-selected="true" data-mode="login" data-i18n="login">כניסה</button>
        <button type="button" role="tab" aria-selected="false" data-mode="signup" data-i18n="signup">משתמש חדש</button>
      </div>
      <form class="auth-body" id="authForm" method="post" action="#" autocomplete="on" novalidate>
        <div class="f" id="nameField" hidden><label for="aName" data-i18n="name">שם</label><input id="aName" autocomplete="name"></div>
        <div class="f"><label for="aUser" data-i18n="username">שם משתמש</label><input id="aUser" autocomplete="username" dir="ltr" autocapitalize="none" spellcheck="false"></div>
        <div class="f"><label for="aPass" data-i18n="password">סיסמה</label><input id="aPass" type="password" autocomplete="current-password" dir="ltr"></div>
        <button class="btn btn-main btn-wide" id="authBtn" type="submit">כניסה</button>
        <p class="err" id="authErr" role="alert"></p>
        <p class="hint" data-i18n="hint"></p>
      </form>
    </div>
  </div>
</section>

<!-- ===== التطبيق ===== -->
<div id="appView" hidden>
  <nav class="modebar" id="modebar"><button type="button" data-mode="out" data-i18n="mode_out"></button><button type="button" data-mode="in" data-i18n="mode_in"></button></nav>
  <div id="outApp">
  <header class="top guilloche">
    <div class="wrap">
      <div class="head-row">
        <h1 class="title" id="appTitle"></h1>
        <div class="head-acts">
          <button class="out out-save" id="fileBtn" data-i18n="save_pc"></button>
          <button class="out" id="backupBtn" data-i18n="backup"></button>
          <button class="out" id="restoreBtn" data-i18n="restore"></button>
          <button class="out" id="wipeBtn" data-i18n="wipe"></button>
          <button class="out" id="logoutBtn" data-i18n="logout"></button>
          <select class="langSel" id="langSel2" aria-label="Language"><option value="he">עברית</option><option value="ar">العربية</option><option value="en">English</option></select>
          <input type="file" id="restoreFile" accept="application/json,.json" hidden>
        </div>
      </div>
      <p class="sub" data-i18n="tagline"></p>
      <p class="fs" id="fsStatus"></p>
      <p class="ver" data-i18n="ver"></p>
      <div class="stats">
        <div class="stat"><b id="sPending">—</b><span data-i18n="st_pending"></span></div>
        <div class="stat"><b id="sSoon">—</b><span id="sSoonLbl"></span></div>
        <div class="stat"><b id="sReturned">—</b><span data-i18n="st_returned"></span></div>
      </div>
    </div>
  </header>

  <main class="wrap">
    <div class="alerts" id="alerts" role="status"></div>
    <div class="sections" id="sections" role="toolbar" aria-label="קבוצות"></div>
    <div class="bar">
      <input class="search" id="q" type="search" data-i18n-ph="search_ph">
      <label class="zoom" data-i18n-title="size"><span class="zs">A</span><input type="range" id="zoom" min="55" max="130" step="5" value="100"><span class="zl">A</span><output id="zoomVal">100%</output></label>
      <button class="btn btn-ghost" id="undoBtn" data-i18n="undo" data-i18n-title="undo_t"></button>
      <button class="btn btn-ghost" id="redoBtn" data-i18n="redo" data-i18n-title="redo_t"></button>
      <button class="btn btn-ghost" id="bulkBtn" data-i18n="bulk_btn"></button>
      <button class="btn btn-main" id="newBtn" data-i18n="new_cheque"></button>
    </div>
    <div class="tabs" id="tabs" role="toolbar" aria-label="סינון לפי סטטוס"></div>
    <div class="months" id="months" role="toolbar" aria-label="חודשים"></div>
    <div id="list"><p class="empty" data-i18n="loading"></p></div>
  </main>
  </div>
  <div id="inApp" hidden>


<div id="in-appView">
  <header class="top ink">
    <div class="wrap">
      <div class="head-row">
        <h1 class="title" id="in-appTitle"></h1>
        <div class="acts">
          <button class="out out-save" id="in-fileBtn" data-in="save_pc"></button>
          <button class="out" id="in-smsBtn" data-in="sms_btn"></button>
          <button class="out" id="in-backupBtn" data-in="backup"></button>
          <button class="out" id="in-restoreBtn" data-in="restore"></button>
          <button class="out" id="in-logoutBtn" data-in="logout"></button>
          <select class="langSel" aria-label="Language"><option value="he">עברית</option><option value="ar">العربية</option><option value="en">English</option></select>
          <input type="file" id="in-restoreFile" accept="application/json,.json" hidden>
        </div>
      </div>
      <p class="sub" data-in="tagline"></p>
      <p class="fs" id="in-fsStatus"></p>
      <div class="stats">
        <div class="stat"><b id="in-sHeld">—</b><span data-in="st_held"></span></div>
        <div class="stat"><b id="in-sMonth">—</b><span id="in-sMonthLbl"></span></div>
        <div class="stat"><b id="in-sRet">—</b><span id="in-sRetLbl"></span></div>
      </div>
    </div>
  </header>

  <main class="wrap">
    <div class="alerts" id="in-alerts"></div>
    <div class="bar">
      <input class="search" id="in-q" type="search" data-in-ph="search_ph">
      <button class="btn btn-ghost" id="in-undoBtn" data-in="undo" data-in-title="undo_t"></button>
      <button class="btn btn-ghost" id="in-redoBtn" data-in-title="redo_t">↷</button>
      <button class="btn btn-main" id="in-newBtn" data-in="new_cheque"></button>
    </div>
    <div class="tabs" id="in-tabs" role="toolbar"></div>
    <div class="months" id="in-months" role="toolbar"></div>
    <div id="in-list"></div>
  </main>
</div>

<!-- cheque form -->
<dialog id="in-dlg">
  <div class="dlg-head ink" id="in-dlgTitle"></div>
  <form class="ff" id="in-form" novalidate>
    <div class="grid">
      <div class="f"><label for="in-customer" data-in="f_customer"></label><input id="in-customer" list="in-custList" autocomplete="off"></div>
      <div class="f"><label for="in-phone" data-in="f_phone"></label><input id="in-phone" type="tel" dir="ltr" autocomplete="off" placeholder="05X-XXXXXXX"></div>
      <div class="f full"><label for="in-purpose" data-in="f_purpose"></label><select id="in-purpose"></select></div>
      <div class="f full"><label for="in-amount" data-in="f_amount"></label>
        <div class="amount-row"><input id="in-amount" class="big" type="number" inputmode="decimal" min="0" step="0.01"><select id="in-currency"><option>₪</option><option>$</option><option>€</option><option>JOD</option></select></div></div>
      <div class="f"><label for="in-dueDate" data-in="f_due"></label><div class="dwrap"><input id="in-dueDate" class="dtext" inputmode="numeric" autocomplete="off" data-in-ph="date_ph"><button type="button" class="dpick" data-in-title="pick_date">📅</button><input type="date" class="dnative" tabindex="-1" aria-hidden="true"></div></div>
      <div class="f"><label for="in-received" data-in="f_received"></label><div class="dwrap"><input id="in-received" class="dtext" inputmode="numeric" autocomplete="off" data-in-ph="date_ph"><button type="button" class="dpick" data-in-title="pick_date">📅</button><input type="date" class="dnative" tabindex="-1" aria-hidden="true"></div></div>
      <div class="sec-t" data-in="sec_cheque"></div>
      <div class="f"><label for="in-number" data-in="f_number"></label><input id="in-number" inputmode="numeric" autocomplete="off"></div>
      <div class="f"><label for="in-bank" data-in="f_bank"></label><input id="in-bank" list="in-bankList" autocomplete="off"></div>
      <div class="f"><label for="in-branch" data-in="f_branch"></label><input id="in-branch" inputmode="numeric" autocomplete="off"></div>
      <div class="f"><label for="in-account" data-in="f_account"></label><input id="in-account" inputmode="numeric" autocomplete="off"></div>
      <div class="f full"><label for="in-drawer" data-in="f_drawer"></label><input id="in-drawer" autocomplete="off" data-in-ph="drawer_ph"></div>
      <div class="sec-t" data-in="sec_where"></div>
      <div class="f"><label for="in-status" data-in="f_status"></label><select id="in-status"></select></div>
      <div class="f" id="in-passedField"><label for="in-passedTo" data-in="f_passed"></label><input id="in-passedTo" list="in-passList" autocomplete="off"></div>
      <div class="f" id="in-passedDateField"><label for="in-passedDate" data-in="f_passed_date"></label><div class="dwrap"><input id="in-passedDate" class="dtext" inputmode="numeric" autocomplete="off" data-in-ph="date_ph"><button type="button" class="dpick" data-in-title="pick_date">📅</button><input type="date" class="dnative" tabindex="-1" aria-hidden="true"></div></div>
      <div class="f full" id="in-reasonField"><label for="in-reason" data-in="f_reason"></label><input id="in-reason" list="in-reasonList" autocomplete="off"></div>
      <div class="f full"><label for="in-notes" data-in="f_notes"></label><textarea id="in-notes" rows="2"></textarea></div>
    </div>
    <p class="err" id="in-err" role="alert"></p>
    <div class="dlg-acts">
      <button type="submit" class="btn btn-main" data-in="save"></button>
      <button type="button" class="btn btn-ghost" id="in-cancelBtn" data-in="cancel"></button>
    </div>
  </form>
</dialog>

<!-- small prompt: passed to / return reason -->
<dialog id="in-askDlg">
  <div class="dlg-head ink" id="in-askTitle"></div>
  <form class="ff" id="in-askForm" novalidate>
    <div class="f"><label for="in-askInput" id="in-askLabel"></label><input id="in-askInput" autocomplete="off"></div>
    <div class="f" id="in-askDateField" style="margin-top:10px"><label for="in-askDate" data-in="f_passed_date"></label><div class="dwrap"><input id="in-askDate" class="dtext" inputmode="numeric" autocomplete="off" data-in-ph="date_ph"><button type="button" class="dpick" data-in-title="pick_date">📅</button><input type="date" class="dnative" tabindex="-1" aria-hidden="true"></div></div>
    <div class="chips" id="in-askChips"></div>
    <p class="err" id="in-askErr"></p>
    <div class="dlg-acts">
      <button type="submit" class="btn btn-main" data-in="ok"></button>
      <button type="button" class="btn btn-ghost" id="in-askCancel" data-in="cancel"></button>
    </div>
  </form>
</dialog>

<!-- SMS settings -->
<dialog id="in-smsDlg">
  <div class="dlg-head ink" data-in="sms_title"></div>
  <form class="ff" id="in-smsForm" novalidate>
    <p class="meta" data-in="sms_intro" style="margin-top:0"></p>
    <div class="grid">
      <div class="f"><label for="in-smsUser" data-in="sms_user"></label><input id="in-smsUser" dir="ltr" autocomplete="off" autocapitalize="none" spellcheck="false"></div>
      <div class="f"><label for="in-smsPass" data-in="sms_pass"></label><input id="in-smsPass" type="password" dir="ltr" autocomplete="off"></div>
      <div class="f full"><label for="in-smsRelay" data-in="sms_relay"></label><input id="in-smsRelay" dir="ltr" autocomplete="off" spellcheck="false" placeholder="https://sms-relay.mhmdsydkbha.workers.dev"></div>
      <label class="full" style="display:flex;gap:8px;align-items:center;color:var(--text)"><input type="checkbox" id="in-smsAuto"> <span data-in="sms_auto"></span></label>
      <div class="f"><label for="in-smsTestPhone" data-in="sms_test_phone"></label><input id="in-smsTestPhone" type="tel" dir="ltr" placeholder="05X-XXXXXXX"></div>
      <div class="f" style="align-self:end"><button type="button" class="btn btn-ghost btn-wide" id="in-smsTest" data-in="sms_test"></button></div>
    </div>
    <p class="err" id="in-smsErr"></p>
    <div class="dlg-acts">
      <button type="submit" class="btn btn-main" data-in="save"></button>
      <button type="button" class="btn btn-ghost" id="in-smsCancel" data-in="close"></button>
    </div>
  </form>
</dialog>

<!-- message to customer -->
<dialog id="in-msgDlg">
  <div class="dlg-head ink" data-in="msg_title"></div>
  <div class="ff">
    <div class="msg-langs" id="in-msgLangs">
      <button type="button" data-ml="ar">العربية</button><button type="button" data-ml="he">עברית</button><button type="button" data-ml="en">English</button>
    </div>
    <div class="f"><label for="in-msgPhone" data-in="f_phone"></label><input id="in-msgPhone" type="tel" dir="ltr"></div>
    <div class="f" style="margin-top:10px"><label for="in-msgText" data-in="msg_text"></label><textarea id="in-msgText"></textarea></div>
    <p class="err" id="in-msgErr"></p>
    <div class="dlg-acts">
      <button type="button" class="btn btn-wa" id="in-sendWa" data-in="send_wa"></button>
      <button type="button" class="btn btn-ghost" id="in-sendSms" data-in="send_sms"></button>
      <button type="button" class="btn btn-ghost" id="in-copyMsg" data-in="copy"></button>
      <button type="button" class="btn btn-ghost" id="in-msgCancel" data-in="close"></button>
    </div>
