$('#bRows').addEventListener('click', e => { if(e.target.classList.contains('x')){ e.target.closest('.brow').remove(); if(!$('#bRows').children.length) bRow(); } });
$('#bCancel').addEventListener('click', () => $('#bulk').close());
$('#bulkForm').addEventListener('submit', e => {
  e.preventDefault();
  const rows = [...$('#bRows').children]; let bad = false; const recs = [];
  rows.forEach(r => {
    const v = bRead(r); r.querySelectorAll('input').forEach(i => i.classList.remove('bad'));
    if(!v.date && !v.payee && !v.amount && !v.notes) return;
    const d = parseDate(v.date);
    if(!d){ r.querySelector('.b-date').classList.add('bad'); bad = true; }
    if(!v.payee){ r.querySelector('.b-payee').classList.add('bad'); bad = true; }
    if(!(+v.amount > 0)){ r.querySelector('.b-amount').classList.add('bad'); bad = true; }
    if(d && v.payee && +v.amount > 0) recs.push(cleanRec({payee:v.payee, amount:v.amount, currency:'₪', dueDate:d, issueDate:todayYmd(), bank:$('#bBank').value, account:'', number:v.number, status:$('#bStatus').value, notes:v.notes, group:$('#bGroup').value}));
  });
  if(bad) return $('#bErr').textContent = t('bulk_bad');
  if(!recs.length) return $('#bErr').textContent = t('bulk_empty');
  recs.forEach(r => checks.push({...r, id: newId()}));
  if(!persist()) return;
  $('#bulk').close();
  if(section !== '__all') section = $('#bGroup').value;
