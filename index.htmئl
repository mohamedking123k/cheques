  if(b.dataset.act==='del'){
    if(!confirm(t('del_confirm',{p:c.payee, a:money(c.amount,c.currency)}))) return;
    checks = checks.filter(x => x.id!==c.id); persist(); render(); toast(t('t_deleted'));
  }
});

