function offerSave(id, password, name){
  try{ if(window.PasswordCredential && navigator.credentials) navigator.credentials.store(new PasswordCredential({id, password, name: name || id})).catch(()=>{}); }catch(e){}
}
function login(username){
  const a = accounts()[username]; if(!a) return showAuth();
  user = {username, name: a.name};
  try{ localStorage.setItem(K_SESSION, username); }catch(e){}
  checks = readJSON(K_DATA(username), []);
  user = {username, name: a.name}; resetHistory();
  section = ''; monthSel = ''; filter = 'بانتظار الصرف';
  setZoom(readJSON(K_ZOOM(username), 100), false);
