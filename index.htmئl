$('#sections').addEventListener('click', e => {
  const b = e.target.closest('.sec');
  if(b){ section=b.dataset.g; filter='بانتظار الصرف'; monthSel=''; return render(); }
  const t = e.target.closest('[data-gact]'); if(!t) return;
  const gs = groups(), act = t.dataset.gact;
  if(section === '__all' && act !== 'add') return toast(t('pick_group'));
  if(act === 'add'){
    const name = (prompt(t('grp_prompt')) || '').trim().slice(0,40);
    if(!name) return;
    if(gs.includes(name)) { section = name; return render(); }
    saveGroups([...gs, name]); section = name; monthSel=''; render(); toast(t('grp_added',{g:name}));
  }
  if(act === 'rename'){
    const name = (prompt(t('grp_ren_prompt',{g:section}), section) || '').trim().slice(0,40);
    if(!name || name === section) return;
    if(gs.includes(name)) return toast(t('grp_exists'));
    checks.forEach(c => { if(groupOf(c) === section) c.group = name; });
    saveGroups(gs.map(g => g === section ? name : g)); persist();
    section = name; render(); toast(t('grp_renamed'));
  }
  if(act === 'del'){
    const n = checks.filter(c => groupOf(c) === section).length;
    if(n) return alert(t('grp_has',{g:section, n}));
    if(gs.length === 1) return toast(t('grp_last'));
    if(!confirm(t('grp_del_confirm',{g:section}))) return;
    saveGroups(gs.filter(g => g !== section)); section = ''; render(); toast(t('grp_deleted'));
  }
});
