/* ===================== טופס ===================== */
function clean(d){
  const s = (v, max=200) => String(v ?? '').trim().slice(0, max);
  const ymd = v => /^\d{4}-\d{2}-\d{2}$/.test(v || '') ? v : '';
  return { customer:s(d.customer), phone:s(d.phone,30), purpose:['debt','purchase','other'].includes(d.purpose)?d.purpose:'', amount:Math.round(Number(d.amount)*100)/100, currency:s(d.currency,5)||'₪', dueDate:ymd(d.dueDate), received:ymd(d.received),
    number:s(d.number,40), bank:s(d.bank), branch:s(d.branch,20), account:s(d.account,40), drawer:s(d.drawer), status:STATUSES.includes(d.status)?d.status:'held',
    passedTo:s(d.passedTo), passedDate:ymd(d.passedDate), reason:s(d.reason), notes:s(d.notes,1000), notified:s(d.notified,40), smsSent:s(d.smsSent,40), updated:new Date().toISOString() };
}
function toggleFields(){ const s = $('#in-status').value; $('#in-passedField').hidden = s !== 'passed' && !$('#in-passedTo').value; $('#in-passedDateField').hidden = $('#in-passedField').hidden; if(s === 'passed' && !$('#in-passedDate').value) $('#in-passedDate').value = fmtDate(todayYmd()); $('#in-reasonField').hidden = s !== 'returned'; }
$('#in-status').addEventListener('change', toggleFields);
$('#in-customer').addEventListener('change', () => { if($('#in-phone').value) return; const last = [...items].reverse().find(c => c.customer === $('#in-customer').value.trim() && c.phone); if(last) $('#in-phone').value = last.phone; });
function openForm(id){
  const c = items.find(x => x.id === id); editingId = c ? c.id : '';
  $('#in-dlgTitle').textContent = c ? t('edit_cheque') : t('new_cheque'); $('#in-err').textContent = '';
  $('#in-status').innerHTML = STATUSES.map(s => `<option value="${s}">${esc(t('s_'+s))}</option>`).join('');
  $('#in-purpose').innerHTML = `<option value="">${esc(t('p_none'))}</option>` + ['debt','purchase','other'].map(p => `<option value="${p}">${esc(t('p_'+p))}</option>`).join('');
  const v = c || {currency:'₪', received:todayYmd(), status:'held'};
  FIELDS.forEach(k => { const el = $('#in-' + k); el.value = (k === 'dueDate' || k === 'received' || k === 'passedDate') ? fmtDate(v[k]) : (v[k] ?? ''); el.classList.remove('bad'); });
  toggleFields(); $('#in-dlg').showModal(); $('#in-customer').focus();
}
$('#in-newBtn').addEventListener('click', () => openForm());
$('#in-cancelBtn').addEventListener('click', () => $('#in-dlg').close());
$('#in-form').addEventListener('submit', e => {
  e.preventDefault();
  const d = {}; FIELDS.forEach(k => d[k] = $('#in-' + k).value); const err = $('#in-err');
  d.passedDate = parseDate(d.passedDate) || (d.status === 'passed' ? todayYmd() : '');
  d.dueDate = parseDate(d.dueDate); d.received = parseDate(d.received) || '';
  if(!d.customer.trim()) return err.textContent = t('e_customer');
  if(!(+d.amount > 0)) return err.textContent = t('e_amount');
  if(d.dueDate === null){ $('#in-dueDate').classList.add('bad'); return err.textContent = t('e_date_bad'); }
  if(!d.dueDate) return err.textContent = t('e_due');
  if(d.status === 'passed' && !d.passedTo.trim()) return err.textContent = t('e_pass');
  const old = items.find(x => x.id === editingId);
  const rec = {...clean({...d, notified: old && old.status === 'returned' && d.status === 'returned' ? old.notified : '', smsSent: old && old.status === 'returned' && d.status === 'returned' ? (old.smsSent || '') : ''}), id: editingId || newId()};
  if(old){ items[items.indexOf(old)] = rec; } else items.push(rec);
  if(!persist()) return;
  $('#in-dlg').close();
  if(filter !== 'all' && !(filter === 'open' ? OPEN.includes(rec.status) : rec.status === filter)) filter = 'all';
  if(monthSel !== 'all') monthSel = rec.dueDate.slice(0,7);
  render(); flash(rec.id);
  toast(old ? t('t_edited') : t('t_saved',{m:mName(rec.dueDate.slice(0,7))}));
  if(rec.status === 'returned' && !rec.notified && (!old || old.status !== 'returned')) onReturned(items.find(x => x.id === rec.id));
});
function flash(id){ const el = $('#in-list').querySelector(`.slip[data-cid="${CSS.escape(id)}"]`); if(el){ el.scrollIntoView({behavior:'smooth', block:'center'}); el.classList.add('flash'); setTimeout(() => el.classList.remove('flash'), 1800); } }

/* חלון קטן: למי הועבר / סיבת החזרה */
let askCb = null;
// כל שמות החברות: מהשיקים היוצאים (הכי הרבה פעמים קודם) + למי שכבר הועברו שיקים
function suppliers(){
  const cnt = new Map();
  const add = (n, w) => { n = String(n || '').trim(); if(n) cnt.set(n, (cnt.get(n) || 0) + w); };
  try{ (typeof checks !== 'undefined' ? checks : []).forEach(c => add(c.payee, 1)); }catch(_){}
  items.forEach(c => add(c.passedTo, 3));
  return [...cnt.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'he')).map(x => x[0]);
}
function drawChips(){
  const box = $('#in-askChips'); if(!askCb || !askCb.chips){ box.innerHTML = ''; return; }
  const q = $('#in-askInput').value.trim().toLowerCase();
  const list = suppliers().filter(n => !q || n.toLowerCase().includes(q));
  box.innerHTML = list.map(n => `<button type="button" class="chip" data-v="${esc(n)}">${esc(n)}</button>`).join('');
}
$('#in-askInput').addEventListener('input', drawChips);
$('#in-askChips').addEventListener('click', e => { const b = e.target.closest('.chip'); if(!b) return; $('#in-askInput').value = b.dataset.v; $('#in-askForm').requestSubmit(); });
function ask(title, label, value, listId, cb, required){
  $('#in-askTitle').textContent = title; $('#in-askLabel').textContent = label; $('#in-askErr').textContent = '';
  const inp = $('#in-askInput'); inp.value = value || ''; inp.setAttribute('list', listId ? 'in-' + listId : ''); askCb = {cb, required, chips: listId === 'passList'};
  $('#in-askDateField').hidden = listId !== 'passList'; $('#in-askDate').value = fmtDate(todayYmd()); $('#in-askDate').classList.remove('bad');
  drawChips(); $('#in-askDlg').showModal(); setTimeout(() => inp.focus(), 50);
}
$('#in-askForm').addEventListener('submit', e => { e.preventDefault(); const v = $('#in-askInput').value.trim(); if(askCb.required && !v) return $('#in-askErr').textContent = t('e_pass'); $('#in-askDlg').close(); askCb.cb(v); });
$('#in-askCancel').addEventListener('click', () => $('#in-askDlg').close());

function setStatus(c, s, extra = {}){
  Object.assign(c, extra, {status: s, updated: new Date().toISOString()});
  if(s !== 'returned'){ c.notified = ''; c.smsSent = ''; }
  if(s === 'held'){ c.passedTo = ''; c.passedDate = ''; }
  delete c.keepPassed;
  persist(); render(); toast(t('t_status',{s:t('s_'+s)}));
}
$('#in-list').addEventListener('click', e => {
  const b = e.target.closest('button[data-act]'); if(!b) return;
  const c = items.find(x => x.id === b.dataset.id); if(!c) return;
  const a = b.dataset.act;
  if(a === 'edit') return openForm(c.id);
  if(a === 'del'){ if(confirm(t('del_confirm',{c:c.customer, a:money(c.amount,c.currency)}))){ items = items.filter(x => x !== c); persist(); render(); toast(t('t_deleted')); } return; }
  if(a === 'passed') return ask(t('ask_pass_t'), t('ask_pass_l'), c.passedTo, 'passList', v => setStatus(c, 'passed', {passedTo: v, passedDate: parseDate($('#in-askDate').value) || todayYmd()}), true);
  if(a === 'returned'){ setStatus(c, 'returned'); onReturned(c); return; }
  if(a === 'notify') return openMsg(c);
  if(['deposited','cleared','held'].includes(a)) setStatus(c, a);
});
$('#in-tabs').addEventListener('click', e => { const b = e.target.closest('.tab'); if(b){ filter = b.dataset.f; if(filter === 'all') monthSel = 'all'; render(); } });
$('#in-months').addEventListener('click', e => { const b = e.target.closest('.mchip'); if(b){ monthSel = b.dataset.month; render(); } });
$('#in-q').addEventListener('input', render);
$('#in-alerts').addEventListener('click', e => {
  const b = e.target.closest('[data-alert]'); if(!b) return; $('#in-q').value = '';
  const k = b.dataset.alert; filter = k === 'ret' ? 'returned' : 'held'; monthSel = k === 'today' ? 'all' : 'all'; render();
  const el = [...$('#in-list').querySelectorAll('.slip')].find(x => { const c = items.find(i => i.id === x.dataset.cid); if(!c) return false; const d = daysUntil(c.dueDate); return k === 'ret' ? (!c.notified && !c.smsSent) : k === 'today' ? d <= 0 : d > 0 && d <= 7; });
  if(el) flash(el.dataset.cid);
});

/* ===================== הודעה ללקוח ===================== */
let msgItem = null, msgLang = 'ar';
function openMsg(c){
  msgItem = c;
  // שפת ההודעה לפי שם הלקוח: ערבית / עברית, אחרת לפי הבחירה האחרונה
  msgLang = /[\u0600-\u06FF]/.test(c.customer) ? 'ar' : /[\u0590-\u05FF]/.test(c.customer) ? 'he' : (localStorage.getItem('incheq:msglang') || (LANG === 'en' ? 'en' : 'ar'));
  $('#in-msgPhone').value = c.phone || ''; $('#in-msgErr').textContent = ''; fillMsg();
  $('#in-sendSms').textContent = smsReady() ? t('sms_now') : t('send_sms');
  $('#in-msgDlg').showModal();
}
function fillMsg(){ document.querySelectorAll('#in-msgLangs button').forEach(b => b.setAttribute('aria-pressed', b.dataset.ml === msgLang)); $('#in-msgText').value = MSG[msgLang](msgItem); $('#in-msgText').dir = msgLang === 'en' ? 'ltr' : 'rtl'; }
$('#in-msgLangs').addEventListener('click', e => { const b = e.target.closest('[data-ml]'); if(!b) return; msgLang = b.dataset.ml; try{ localStorage.setItem('incheq:msglang', msgLang); }catch(_){} fillMsg(); });
/* ===================== SMS אוטומטי (SMS Gateway for Android, Cloud) ===================== */
const K_SMS = () => 'incheq:sms:' + user.username;
const smsCfg = () => readJSON(K_SMS(), {user:'', pass:'', auto:true});
const smsReady = () => { const c = smsCfg(); return !!(c.user && c.pass); };
async function gatewaySend(phone, text, cfg = smsCfg()){
  const n = waNumber(phone); if(!n) throw new Error(t('no_phone'));
  let r;
  try{
    const url = (cfg.relay || '').trim().replace(/\/+$/, '') || 'https://sms-relay.mhmdsydkbha.workers.dev';
    r = await fetch(url, { method:'POST',
      headers:{ 'Authorization':'Basic ' + btoa(unescape(encodeURIComponent(cfg.user + ':' + cfg.pass))), 'Content-Type':'application/json' },
      body: JSON.stringify({ textMessage:{ text }, phoneNumbers:['+' + n] }) });
  }catch(e){ throw new Error('network: ' + url.replace('https://','')); }
  if(!r.ok){ let m = 'HTTP ' + r.status; try{ const j = await r.json(); if(j && j.message) m += ' ' + j.message; }catch(_){} throw new Error(m); }
  return true;
}
const msgLangFor = c => /[\u0600-\u06FF]/.test(c.customer) ? 'ar' : /[\u0590-\u05FF]/.test(c.customer) ? 'he' : (localStorage.getItem('incheq:msglang') || (LANG === 'en' ? 'en' : 'ar'));
async function smsTo(c, text){
  toast(t('sms_sending'));
  try{ await gatewaySend(c.phone, text); c.smsSent = new Date().toISOString(); persist(); render(); toast(t('sms_ok')); return true; }
  catch(e){ toast(t('sms_fail', {e: e.message})); return false; }
}
// כשמסמנים "חזר": SMS אוטומטי (אם מוגדר) ואז חלון וואטסאפ מוכן
async function onReturned(c){
  const cfg = smsCfg();
  if(cfg.user && cfg.pass && cfg.auto && c.phone && !c.smsSent) await smsTo(c, MSG[msgLangFor(c)](c));
  openMsg(c);
}
$('#in-smsBtn').addEventListener('click', () => {
  const c = smsCfg(); $('#in-smsUser').value = c.user || ''; $('#in-smsPass').value = c.pass || ''; $('#in-smsAuto').checked = c.auto !== false; $('#in-smsRelay').value = c.relay || ''; $('#in-smsErr').textContent = '';
  $('#in-smsDlg').showModal();
});
$('#in-smsCancel').addEventListener('click', () => $('#in-smsDlg').close());
const readSmsForm = () => ({ user: $('#in-smsUser').value.trim(), pass: $('#in-smsPass').value.trim(), relay: $('#in-smsRelay').value.trim(), auto: $('#in-smsAuto').checked });
$('#in-smsForm').addEventListener('submit', e => { e.preventDefault(); writeJSON(K_SMS(), readSmsForm()); $('#in-smsDlg').close(); toast(t('sms_saved')); render(); });
$('#in-smsTest').addEventListener('click', async () => {
  const cfg = readSmsForm(); const err = $('#in-smsErr'); err.textContent = '';
  if(!cfg.user || !cfg.pass) return err.textContent = t('sms_need');
  const b = $('#in-smsTest'); b.disabled = true; b.textContent = t('sms_sending');
  try{ await gatewaySend($('#in-smsTestPhone').value, t('sms_test_text'), cfg); err.style.color = 'var(--ok)'; err.textContent = t('sms_test_ok'); }
  catch(x){ err.style.color = ''; err.textContent = t('sms_fail', {e: x.message}); }
  finally{ b.disabled = false; b.textContent = t('sms_test'); }
});

function markSent(){
  const ph = $('#in-msgPhone').value.trim();
  msgItem.notified = new Date().toISOString(); if(ph && !msgItem.phone) msgItem.phone = ph;
  persist(); render();
}
$('#in-sendWa').addEventListener('click', () => {
  const n = waNumber($('#in-msgPhone').value); if(!n) return $('#in-msgErr').textContent = t('no_phone');
  window.open('https://wa.me/' + n + '?text=' + encodeURIComponent($('#in-msgText').value), '_blank');
  markSent(); $('#in-msgDlg').close();
});
$('#in-sendSms').addEventListener('click', async () => {
  const p = $('#in-msgPhone').value.replace(/[^\d+]/g, ''); if(!p) return $('#in-msgErr').textContent = t('no_phone');
  if(smsReady()){ if(!msgItem.phone) msgItem.phone = $('#in-msgPhone').value.trim(); const ok = await smsTo({...msgItem, phone: p}, $('#in-msgText').value); if(ok){ msgItem.smsSent = new Date().toISOString(); persist(); render(); $('#in-msgDlg').close(); } return; }
  location.href = 'sms:' + p + '?body=' + encodeURIComponent($('#in-msgText').value);
  markSent(); $('#in-msgDlg').close();
});
$('#in-copyMsg').addEventListener('click', async () => { try{ await navigator.clipboard.writeText($('#in-msgText').value); toast(t('copied')); }catch(_){ $('#in-msgText').select(); document.execCommand('copy'); toast(t('copied')); } });
$('#in-msgCancel').addEventListener('click', () => $('#in-msgDlg').close());

/* ===================== שפה ===================== */
function applyLang(){
  const r = document.documentElement; r.lang = LANG; r.dir = LANG === 'en' ? 'ltr' : 'rtl';
  $('#inApp').querySelectorAll('[data-in]').forEach(el => el.textContent = t(el.dataset.in));
  $('#inApp').querySelectorAll('[data-in-ph]').forEach(el => el.placeholder = t(el.dataset.inPh));
  $('#inApp').querySelectorAll('[data-in-title]').forEach(el => { el.title = t(el.dataset.inTitle); el.setAttribute('aria-label', t(el.dataset.inTitle)); });
  if(user){ $('#in-appTitle').textContent = t('app'); fsStatus(fsLast); render(); }
}


window.IN = {
  show(){ const u = window.__mainUser(); if(!u) return; if(!user || user.username !== u.username) login(u.username, u.name); else render(); applyLang(); },
  lang(){ applyLang(); },
  openForm(){ openForm(); },
  reset(){ user = null; items = []; }
};
})();
</script>
