#inApp .stat{background:var(--ink);padding:12px 14px}
#inApp .stat b{display:block;font-family:var(--serif);font-size:1.45rem;color:#E9D7A6;line-height:1.35;direction:ltr;text-align:start}
#inApp .stat span{font-size:.82rem;color:#C3D0DF}
#inApp .stat small{display:block;font-size:.75rem;opacity:.85}
#inApp main{padding:18px 20px 60px}
#inApp .alerts{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}
#inApp .alerts:empty{display:none}
