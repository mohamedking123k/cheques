function setMode(mode){
  authMode = mode;
  document.querySelectorAll('.auth-tabs button').forEach(b => b.setAttribute('aria-selected', b.dataset.mode===mode));
  $('#nameField').hidden = mode !== 'signup';
  $('#authBtn').textContent = mode === 'signup' ? t('create') : t('enter');
  $('#aPass').autocomplete = mode === 'signup' ? 'new-password' : 'current-password';
  $('#authErr').textContent = '';
}
document.querySelectorAll('.auth-tabs button').forEach(b => b.addEventListener('click', () => setMode(b.dataset.mode)));

$('#authForm').addEventListener('submit', async e => {
  e.preventDefault();
  const username = $('#aUser').value.trim().toLowerCase();
  const pass = $('#aPass').value, name = $('#aName').value.trim();
  const errEl = $('#authErr');
  if(!username) return errEl.textContent = t('err_user');
  if(!/^[a-z0-9._-]{3,30}$/.test(username)) return errEl.textContent = t('err_user_fmt');
  if(pass.length < 4) return errEl.textContent = t('err_pass');
  const accs = accounts();
  if(authMode === 'signup'){
    if(!name) return errEl.textContent = t('err_name');
    if(accs[username]) return errEl.textContent = t('err_exists');
    const salt = newId();
    accs[username] = {name, salt, hash: await hashPass(pass, salt), created: new Date().toISOString()};
    if(!writeJSON(K_ACCOUNTS, accs)) return;
    offerSave(username, pass, name || (accounts()[username]||{}).name);
    login(username);
  } else {
    const a = accs[username];
    if(!a || a.hash !== await hashPass(pass, a.salt)) return errEl.textContent = t('err_login');
    offerSave(username, pass, name || (accounts()[username]||{}).name);
    login(username);
  }
});

