let undoStack = [], redoStack = [], curState = '';
const stateNow = () => JSON.stringify(items);
function resetHistory(){ undoStack = []; redoStack = []; curState = stateNow(); updUndo(); }
function updUndo(){ $('#in-undoBtn').disabled = !undoStack.length; $('#in-redoBtn').disabled = !redoStack.length; }
function persist(){
  if(!writeJSON(K_DATA(user.username), items)) return false;
  const now = stateNow(); if(now !== curState){ undoStack.push(curState); if(undoStack.length > 60) undoStack.shift(); redoStack = []; curState = now; }
  updUndo(); scheduleAutoSave(); return true;
}
function applyState(str){ items = JSON.parse(str); writeJSON(K_DATA(user.username), items); curState = str; scheduleAutoSave(); render(); updUndo(); }
function undo(){ if(!user) return; if(!undoStack.length) return toast(t('nothing_undo')); redoStack.push(curState); applyState(undoStack.pop()); toast(t('undone')); }
function redo(){ if(!user) return; if(!redoStack.length) return toast(t('nothing_redo')); undoStack.push(curState); applyState(redoStack.pop()); toast(t('redone')); }
$('#in-undoBtn').addEventListener('click', undo); $('#in-redoBtn').addEventListener('click', redo);
document.addEventListener('keydown', e => {
  if(!user || $('#inApp').hidden || document.querySelector('dialog[open]')) return;
  const tag = (e.target.tagName || '').toLowerCase(); if(['input','textarea','select'].includes(tag)) return;
  const k = e.key.toLowerCase();
  if((e.ctrlKey || e.metaKey) && k === 'z' && !e.shiftKey){ e.preventDefault(); undo(); }
  if((e.ctrlKey || e.metaKey) && (k === 'y' || (k === 'z' && e.shiftKey))){ e.preventDefault(); redo(); }
});

