  else if(v === null) e.target.classList.add('bad');
  else e.target.classList.remove('bad');
});

/* ---------- أدوات ---------- */
function esc(s){ return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function fmt(n){ return Number(n).toLocaleString('en-US',{maximumFractionDigits:2}); }
function money(n, cur){ return cur + ' ' + fmt(n); }
function todayYmd(){ const d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
function daysUntil(ymd){ return Math.round((new Date(ymd+'T00:00:00') - new Date(todayYmd()+'T00:00:00'))/864e5); }
function sumText(list){
  if(!list.length) return '0';
  const by = {}; list.forEach(c => by[c.currency] = (by[c.currency]||0) + c.amount);
  return Object.entries(by).map(([cur,v]) => money(v,cur)).join(' + ');
}
function toast(msg){ const t=$('#toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(t._h); t._h=setTimeout(()=>t.classList.remove('show'),2600); }

